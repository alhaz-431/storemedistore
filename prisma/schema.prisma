generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  image     String?
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

activityLogs ActivityLog[]
phone     String?
  address   String?
  medicines  Medicine[]  @relation("SellerMedicines")
  orders     Order[]     @relation("CustomerOrders")
  reviews    Review[]
  orderItems OrderItem[] @relation("SellerOrderItems")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  medicines Medicine[]
}

model Medicine {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  price        Decimal  // ফ্রন্টএন্ডে float/number হিসেবে পাঠালে হবে
  stock        Int
  image        String?
  manufacturer String   // এটি অবশ্যই থাকতে হবে
  description  String?  // এটি ঐচ্ছিক
  
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  sellerId     String
  seller       User     @relation("SellerMedicines", fields: [sellerId], references: [id])
orderItems   OrderItem[]
reviews      Review[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  totalAmount     Decimal
  status          OrderStatus @default(PENDING)
  shippingAddress String
  shippingName    String
  shippingPhone   String

  customerId String
  customer   User @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt // 👈 পুরোনো ৫৩টি অর্ডার বাঁচানোর জন্য ডিফল্ট টাইমস্ট্যাম্প
}

model OrderItem {
  id         String @id @default(uuid())

  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  sellerId   String?  
  seller     User? @relation("SellerOrderItems", fields: [sellerId], references: [id])

  quantity   Int
  price      Decimal
}

model Review {
  id        String @id @default(uuid())
  rating    Int
  comment   String

  customerId String
  customer   User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, medicineId])
}
model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // যেমন: "ADD_MEDICINE" বা "EDIT_MEDICINE"
  medicineId String
  userId    String
  user      User     @relation(fields: [userId], references: [id]) 
  createdAt DateTime @default(now())
}